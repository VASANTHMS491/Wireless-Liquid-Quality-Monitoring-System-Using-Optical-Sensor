#include <WiFi.h>

#define TURBIDITY_PIN 34
#define THRESHOLD_VOLTAGE 2.5   // You can adjust this

// WiFi credentials
const char* ssid = "Turbidity_Monitor";
const char* password = "12345678";

WiFiServer server(80);

// Sensor variables
int adcValue = 0;
float v_esp = 0;
float v_sensor = 0;
float ntu = 0;

// Global variables for webpage
String waterStatus = "UNKNOWN";
String statusColor = "#000000";

void setup() {
  Serial.begin(115200);
  analogReadResolution(12);

  // Start WiFi AP
  WiFi.softAP(ssid, password);
  Serial.println("WiFi Started");
  Serial.print("IP Address: ");
  Serial.println(WiFi.softAPIP());

  server.begin();
}

void loop() {

  // ───── SENSOR READING ─────
  adcValue = analogRead(TURBIDITY_PIN);

  v_esp = (adcValue / 4095.0) * 3.3;
  v_sensor = (3.0 / 2.0) * v_esp;

  ntu = 32.175 * v_sensor * v_sensor - 962.033 * v_sensor + 3472.973;

  // ───── WATER STATUS ─────
  if ( v_sensor> THRESHOLD_VOLTAGE) {
    waterStatus = "CLEAN";
    statusColor = "#27ae60";  // green
  } else {
    waterStatus = "NOT CLEAN";
    statusColor = "#e74c3c";  // red
  }

  // Serial Monitor Output
  Serial.print("NTU: ");
  Serial.print(ntu);
  Serial.print(" | Status: ");
  Serial.println(waterStatus);

  // ───── HANDLE CLIENT ─────
  WiFiClient client = server.available();

  if (client) {
    Serial.println("Client Connected");

    while (client.connected() && !client.available()) {
      delay(1);
    }

    client.readStringUntil('\r'); // clear request

    // ───── WEBPAGE ─────
    client.println("HTTP/1.1 200 OK");
    client.println("Content-type:text/html");
    client.println("Connection: close");
    client.println();

    client.println("<!DOCTYPE html><html>");
    client.println("<head>");
    client.println("<meta name='viewport' content='width=device-width, initial-scale=1'>");
    client.println("<meta http-equiv='refresh' content='2'>");

    // Styling
    client.println("<style>");
    client.println("body{font-family:Arial;text-align:center;background:#f4f6f7;}");
    client.println(".card{background:white;padding:20px;margin:20px;border-radius:10px;box-shadow:0 4px 10px rgba(0,0,0,0.1);}");
    client.println(".value{font-size:30px;font-weight:bold;}");
    client.println("</style>");

    client.println("</head><body>");

    client.println("<h1>💧 Turbidity Monitor</h1>");

    // STATUS
    client.println("<div class='card'>");
    client.println("<h2 style='color:" + statusColor + ";'>" + waterStatus + "</h2>");
    client.println("</div>");

    // NTU
    client.println("<div class='card'>");
    client.println("<p>NTU Value</p>");
    client.println("<div class='value'>" + String(ntu, 2) + "</div>");
    client.println("</div>");

    // Voltage
    client.println("<div class='card'>");
    client.println("<p>Sensor Voltage</p>");
    client.println("<div class='value'>" + String(v_sensor, 2) + " V</div>");
    client.println("</div>");

    client.println("</body></html>");

    client.stop();
    Serial.println("Client Disconnected");
  }

  delay(1000);
}
